{
  "name": "our-story",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run --passWithNoTests",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test --pass-with-no-tests",
    "db:push": "supabase db push --local",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase db test --local",
    "db:types": "supabase gen types typescript --local > app/types/database.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@nuxtjs/color-mode": "^4.0.0",
    "@nuxtjs/i18n": "^10.2.4",
    "@nuxtjs/supabase": "^2.0.5",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@sentry/nuxt": "^10.48.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vueuse/core": "^14.2.1",
    "@vueuse/nuxt": "^14.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exifr": "^7.1.3",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^4.4.2",
    "posthog-js": "^1.373.0",
    "reka-ui": "^2.9.5",
    "resend": "^6.10.0",
    "tailwind-merge": "^3.5.0",
    "vaul-vue": "^0.4.1",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@vitest/ui": "^4.1.4",
    "playwright": "^1.59.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "vitest": "^4.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@sentry/cli",
      "esbuild",
      "vue-demi"
    ],
    "ignoredBuiltDependencies": [
      "core-js",
      "protobufjs"
    ]
  }
}
