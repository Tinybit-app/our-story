# ============================================================
# Environment variables — three tiers:
#
#   Local       .env (this file, gitignored)  →  supabase start
#   Dev         Vercel Preview scope          →  our-story-dev Supabase project
#   Production  Vercel Production scope       →  our-story Supabase project
#
# In Vercel: Settings → Environment Variables → set scope per variable
# ============================================================

# Supabase — local: from `supabase start` output
#             dev/prod: from Supabase dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Random 32-char secret for grandparent view-only JWTs
# Generate: openssl rand -base64 32
JWT_SECRET=

# Resend — leave empty locally (emails log to Supabase Studio)
# https://resend.com/api-keys
RESEND_API_KEY=

# Upstash Redis — leave empty locally (no rate limiting in dev)
# https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Base URL — used in invite emails and view-only links
# Local: http://localhost:3000  |  Production: https://our-story.tinybit.app
APP_URL=http://localhost:3000

# Sentry — leave empty locally (errors log to console)
# https://sentry.io → Project → Settings → Client Keys
SENTRY_DSN=
# Sentry auth token for source map uploads (CI/CD only)
SENTRY_AUTH_TOKEN=
